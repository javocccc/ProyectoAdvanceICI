rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // El documento usuarios/<uid> lo administra alguien con acceso a Firebase.
    function rolUsuario() {
      return request.auth == null ? null
        : get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function puedeLeer() {
      return rolUsuario() in ['direccion', 'secretaria', 'consulta'];
    }

    function esDireccion() {
      return rolUsuario() == 'direccion';
    }

    function esSecretaria() {
      return rolUsuario() == 'secretaria';
    }

    function creacionSecretaria() {
      return request.resource.data.colegiatura == 'sin-informar'
        && !('acta' in request.resource.data)
        && !('fechaColegiatura' in request.resource.data)
        && request.resource.data.historialColegiatura == [];
    }

    function edicionAcademicaSecretaria() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'nombre', 'rut', 'anioEgreso', 'semestreEgreso', 'fechaExamen',
        'notaExamen', 'comision', 'historialAuditoria'
      ]);
    }

    match /expedientes/{id} {
      allow get, list: if puedeLeer();
      allow create: if esDireccion() || (esSecretaria() && creacionSecretaria());
      allow update: if esDireccion() || (esSecretaria() && edicionAcademicaSecretaria());
      allow delete: if false;

      match /auditoria/{registroId} {
        allow get, list: if puedeLeer();
        allow create, update, delete: if false;
      }
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Crear este documento manualmente en la consola Firebase.
    }

    match /configuracion/sistema {
      allow get: if true;
      allow list: if false;
      allow create, update: if esDireccion()
        && request.resource.data.keys().hasOnly([
          'mantenimiento', 'mensaje', 'actualizadoEn', 'actualizadoPor'
        ])
        && request.resource.data.mantenimiento is bool
        && request.resource.data.mensaje is string
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoPor == request.auth.token.email;
      allow delete: if false;
    }

    match /consultasExpedientes/{consultaId} {
      allow get, list: if esDireccion();
      allow create: if puedeLeer()
        && request.resource.data.keys().hasOnly([
          'fecha', 'usuario', 'usuarioId', 'expedienteId', 'accion'
        ])
        && request.resource.data.keys().hasAll([
          'fecha', 'usuario', 'usuarioId', 'expedienteId', 'accion'
        ])
        && request.resource.data.fecha == request.time
        && request.resource.data.usuario == request.auth.token.email
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.expedienteId is string
        && request.resource.data.accion == 'Consulta de expediente'
        && exists(/databases/$(database)/documents/expedientes/$(request.resource.data.expedienteId));
      allow update, delete: if false;
    }
  }
}
