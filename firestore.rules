rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // El documento usuarios/<uid> lo administra alguien con acceso a Firebase.
    function rolUsuario() {
      return request.auth == null ? null
        : get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function puedeLeer() {
      return rolUsuario() in ['direccion', 'secretaria', 'consulta'];
    }

    function esDireccion() {
      return rolUsuario() == 'direccion';
    }

    function esSecretaria() {
      return rolUsuario() == 'secretaria';
    }

    function creacionSecretaria() {
      return request.resource.data.colegiatura == 'sin-informar'
        && !('acta' in request.resource.data)
        && !('fechaColegiatura' in request.resource.data)
        && request.resource.data.historialColegiatura == [];
    }

    function edicionAcademicaSecretaria() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'nombre', 'rut', 'anioEgreso', 'semestreEgreso', 'fechaExamen',
        'notaExamen', 'comision', 'historialAuditoria'
      ]);
    }

    match /expedientes/{id} {
      allow get, list: if puedeLeer();
      allow create: if esDireccion() || (esSecretaria() && creacionSecretaria());
      allow update: if esDireccion() || (esSecretaria() && edicionAcademicaSecretaria());
      allow delete: if false;

      match /auditoria/{registroId} {
        allow get, list: if puedeLeer();
        allow create, update, delete: if false;
      }
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Crear este documento manualmente en la consola Firebase.
    }
  }
}
