rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // El documento usuarios/<uid> lo administra alguien con acceso a Firebase.
    function rolUsuario() {
      return request.auth == null ? null
        : get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function esAdministrador() {
      return rolUsuario() in ['administrador', 'direccion']
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo != false;
    }

    function esCoordinador() {
      return rolUsuario() in ['coordinador', 'secretaria']
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo != false;
    }

    function esEstudiante() {
      return rolUsuario() in ['estudiante', 'consulta'];
    }

    function puedeLeer() {
      return esAdministrador() || esCoordinador();
    }

    function esEstudianteVinculado(id) {
      return esEstudiante()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo != false
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.expedienteId == id
        && get(/databases/$(database)/documents/expedientes/$(id)).data.estudianteUid == request.auth.uid;
    }

    function puedeRegistrarConsulta(id) {
      return puedeLeer() || esEstudianteVinculado(id);
    }

    function puedeLeerExpediente(id) {
      return puedeLeer()
        || (esEstudianteVinculado(id) && resource.data.estudianteUid == request.auth.uid);
    }

    function creacionCoordinador() {
      return request.resource.data.keys().hasOnly([
          'id', 'nombre', 'rut', 'anioEgreso', 'semestreEgreso', 'fechaExamen',
          'notaExamen', 'comision', 'colegiatura', 'fechaCreacion', 'creadoPor',
          'historialColegiatura', 'historialAuditoria'
        ])
        && request.resource.data.colegiatura == 'sin-informar'
        && !('acta' in request.resource.data)
        && !('fechaColegiatura' in request.resource.data)
        && request.resource.data.historialColegiatura == [];
    }

    match /expedientes/{id} {
      allow get: if puedeLeerExpediente(id);
      allow list: if puedeLeer();
      allow create: if esAdministrador() || (esCoordinador() && creacionCoordinador());
      allow update: if esAdministrador()
        || (esCoordinador() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'rut', 'anioEgreso', 'semestreEgreso', 'fechaExamen',
          'notaExamen', 'comision', 'acta', 'historialAuditoria'
        ]));
      allow delete: if false;

      match /auditoria/{registroId} {
        allow get, list: if puedeLeer() || esEstudianteVinculado(id);
        allow create, update, delete: if false;
      }
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Crear este documento manualmente en la consola Firebase.
    }

    match /configuracion/sistema {
      allow get: if true;
      allow list: if false;
      allow create, update: if esAdministrador()
        && request.resource.data.keys().hasOnly([
          'mantenimiento', 'mensaje', 'actualizadoEn', 'actualizadoPor'
        ])
        && request.resource.data.mantenimiento is bool
        && request.resource.data.mensaje is string
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoPor == request.auth.token.email;
      allow delete: if false;
    }

    match /consultasExpedientes/{consultaId} {
      allow get, list: if esAdministrador();
      allow create: if puedeRegistrarConsulta(request.resource.data.expedienteId)
        && request.resource.data.keys().hasOnly([
          'fecha', 'usuario', 'usuarioId', 'expedienteId', 'accion'
        ])
        && request.resource.data.keys().hasAll([
          'fecha', 'usuario', 'usuarioId', 'expedienteId', 'accion'
        ])
        && request.resource.data.fecha == request.time
        && request.resource.data.usuario == request.auth.token.email
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.expedienteId is string
        && request.resource.data.accion == 'Consulta de expediente'
        && exists(/databases/$(database)/documents/expedientes/$(request.resource.data.expedienteId));
      allow update, delete: if false;
    }
  }
}
