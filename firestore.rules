rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo una cuenta autenticada con rol direccion puede leer o modificar fichas.
    function esDireccion() {
      // El uid de Authentication debe tener un documento usuarios/<uid>
      // creado por un administrador con rol "direccion".
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'direccion';
    }

    match /expedientes/{id} {
      // Dirección registra cambios e historial en el mismo documento.
      allow get, list, create, update: if esDireccion();
      allow delete: if false;

      match /auditoria/{registroId} {
        allow get, list: if esDireccion();
        allow create, update, delete: if false;
      }
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Crear este documento manualmente en la consola Firebase.
    }
  }
}
