rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // El documento usuarios/<uid> lo administra alguien con acceso a Firebase.
    function rolUsuario() {
      return request.auth == null ? null
        : get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', null);
    }

    function esAdministrador() {
      return rolUsuario() in ['administrador', 'direccion']
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('activo', true) != false;
    }

    function esCoordinador() {
      return rolUsuario() in ['coordinador', 'secretaria']
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('activo', true) != false;
    }

    function esEstudiante() {
      return rolUsuario() in ['estudiante', 'consulta'];
    }

    function puedeLeer() {
      return esAdministrador() || esCoordinador();
    }

    function sistemaDisponible() {
      return esAdministrador()
        || !exists(/databases/$(database)/documents/configuracion/sistema)
        || get(/databases/$(database)/documents/configuracion/sistema).data.get('mantenimiento', false) != true;
    }

    function perfilValido() {
      return request.resource.data.keys().hasOnly(['email', 'nombre', 'rol', 'activo', 'expedienteId'])
        && request.resource.data.keys().hasAll(['email', 'nombre', 'rol', 'activo'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.rol in ['administrador', 'direccion', 'coordinador', 'secretaria', 'estudiante', 'consulta']
        && request.resource.data.activo is bool
        && (!('expedienteId' in request.resource.data)
          || (request.resource.data.rol in ['estudiante', 'consulta']
            && request.resource.data.expedienteId is string
            && request.resource.data.expedienteId.size() > 0
            && request.resource.data.expedienteId.size() <= 100));
    }

    function esEstudianteVinculado(id) {
      return esEstudiante()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('activo', true) != false
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.expedienteId == id
        && get(/databases/$(database)/documents/expedientes/$(id)).data.estudianteUid == request.auth.uid;
    }

    function puedeRegistrarConsulta(id) {
      return puedeLeer() || esEstudianteVinculado(id);
    }

    function puedeLeerExpediente(id) {
      return puedeLeer()
        || (esEstudianteVinculado(id) && resource.data.estudianteUid == request.auth.uid);
    }

    function creacionCoordinador() {
      return request.resource.data.keys().hasOnly([
          'id', 'nombre', 'rut', 'anioEgreso', 'semestreEgreso', 'fechaExamen',
          'notaExamen', 'comision', 'colegiatura', 'fechaCreacion', 'creadoPor',
          'historialColegiatura', 'historialAuditoria'
        ])
        && request.resource.data.colegiatura == 'sin-informar'
        && !('acta' in request.resource.data)
        && !('fechaColegiatura' in request.resource.data)
        && request.resource.data.historialColegiatura == [];
    }

    match /expedientes/{id} {
      allow get: if sistemaDisponible() && puedeLeerExpediente(id);
      allow list: if sistemaDisponible() && puedeLeer();
      allow create: if sistemaDisponible() && (esAdministrador() || (esCoordinador() && creacionCoordinador()));
      allow update: if sistemaDisponible() && (esAdministrador()
        || (esCoordinador() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'rut', 'anioEgreso', 'semestreEgreso', 'fechaExamen',
          'notaExamen', 'comision', 'acta', 'historialAuditoria'
        ])));
      allow delete: if false;

      match /auditoria/{registroId} {
        allow get, list: if sistemaDisponible() && (puedeLeer() || esEstudianteVinculado(id));
        allow create, update, delete: if false;
      }
    }

    match /usuarios/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || esAdministrador();
      allow create: if esAdministrador()
        && perfilValido()
        && request.resource.data.activo == true;
      allow update: if esAdministrador()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'rol', 'activo', 'expedienteId'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['nombre'])
          || (request.resource.data.nombre is string
            && request.resource.data.nombre.size() > 0
            && request.resource.data.nombre.size() <= 120))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol'])
          || request.resource.data.rol in ['administrador', 'coordinador', 'estudiante'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['activo'])
          || request.resource.data.activo is bool)
        && resource.data.get('activo', true) == true
        && (request.resource.data.get('expedienteId', null) == null
          || (request.resource.data.get('rol', null) in ['estudiante', 'consulta']
            && request.resource.data.expedienteId is string
            && request.resource.data.expedienteId.size() > 0
            && request.resource.data.expedienteId.size() <= 100))
        // Siempre debe quedar activa la cuenta del Administrador que realiza el cambio.
        && (uid != request.auth.uid
          || (request.resource.data.rol in ['administrador', 'direccion']
            && request.resource.data.activo == true));
      allow delete: if false;
    }

    match /configuracion/sistema {
      allow get: if true;
      allow list: if false;
      allow create, update: if esAdministrador()
        && request.resource.data.keys().hasOnly([
          'mantenimiento', 'mensaje', 'actualizadoEn', 'actualizadoPor'
        ])
        && request.resource.data.mantenimiento is bool
        && request.resource.data.mensaje is string
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoPor == request.auth.token.email;
      allow delete: if false;
    }

    match /consultasExpedientes/{consultaId} {
      allow get, list: if esAdministrador();
      allow create: if sistemaDisponible() && puedeRegistrarConsulta(request.resource.data.expedienteId)
        && request.resource.data.keys().hasOnly([
          'fecha', 'usuario', 'usuarioId', 'expedienteId', 'accion'
        ])
        && request.resource.data.keys().hasAll([
          'fecha', 'usuario', 'usuarioId', 'expedienteId', 'accion'
        ])
        && request.resource.data.fecha == request.time
        && request.resource.data.usuario == request.auth.token.email
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.expedienteId is string
        && request.resource.data.accion == 'Consulta de expediente'
        && exists(/databases/$(database)/documents/expedientes/$(request.resource.data.expedienteId));
      allow update, delete: if false;
    }
  }
}
