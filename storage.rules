rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function puedeGestionarActas() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.activo != false
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in [
          'administrador', 'coordinador', 'direccion', 'secretaria'
        ];
    }

    match /actas/{expedienteId}/{nombreArchivo} {
      // Solo se aceptan PDF menores a 10 MB, además del control de la interfaz.
      allow read: if puedeGestionarActas();
      allow create, update: if puedeGestionarActas()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if puedeGestionarActas();
    }
  }
}
