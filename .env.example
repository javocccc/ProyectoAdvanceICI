# Copia este archivo como .env cuando crees el proyecto Firebase.
# La configuración web identifica el proyecto; las reglas de Firebase protegen los datos.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo URL y clave publicable. Nunca pongas la service_role key en Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
